# Copy this file to .env for local development. Never commit real secrets.
# Docker Compose and StockPilot's Spring Boot configuration load this file.
# Operating-system environment variables still take precedence.

SERVER_PORT=8085

# Read-only AI assistant. Never put a real API key in this example.
# Provider: CUSTOM, QWEN, DEEPSEEK, GLM, DOUBAO, MOONSHOT.
# QWEN/CUSTOM require an explicit base URL; other presets provide a default.
# AI_BASE_URL overrides presets, without the /chat/completions suffix.
# Select a model supporting function tools and non-thinking mode.
AI_ENABLED=false
AI_PROVIDER=CUSTOM
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=20s
AI_TOTAL_TIMEOUT=90s
AI_MAX_TOOL_CALLS=6

DB_URL=jdbc:mysql://localhost:3307/stockpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=stockpilot
DB_PASSWORD=stockpilot_dev
MYSQL_HOST_PORT=3307

JWT_SECRET=replace-with-at-least-32-character-secret
JWT_ACCESS_TOKEN_MINUTES=60

# First startup only: set both to create an ADMIN user, then clear them.
# An existing username is never reset by these settings.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# First startup only: set both to create an ADMIN user, then clear them.
# An existing username is never reset by these settings.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Set to true only when the corresponding local service is running.
CACHE_ENABLED=false
CACHE_KEY_PREFIX=stockpilot:v1
CACHE_SKU_TTL=30m
CACHE_WAREHOUSE_TTL=30m
CACHE_NULL_TTL=60s
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_PORT=6380
REDIS_CONNECT_TIMEOUT=500ms
REDIS_TIMEOUT=500ms

RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
RABBITMQ_USERNAME=stockpilot
RABBITMQ_PASSWORD=stockpilot_dev
RABBITMQ_VHOST=/stockpilot
RABBITMQ_CONNECTION_TIMEOUT=3s
RABBITMQ_EXCHANGE=stockpilot.business.v1
RABBITMQ_COMPLETION_QUEUE=stockpilot.completion.low-stock.v1
RABBITMQ_DLX=stockpilot.dead-letter.v1
RABBITMQ_DLQ=stockpilot.completion.low-stock.dlq.v1
RABBITMQ_DLQ_ROUTING_KEY=stockpilot.completion.low-stock.dead
RABBITMQ_PUBLISHER_BATCH_SIZE=20
RABBITMQ_PUBLISHER_MAX_ATTEMPTS=8
RABBITMQ_CONFIRM_TIMEOUT=5s
RABBITMQ_PUBLISHER_FIXED_DELAY=2000
RABBITMQ_CONSUMER_MAX_ATTEMPTS=3
RABBITMQ_CONSUMER_INITIAL_BACKOFF=500ms
RABBITMQ_CONSUMER_MAX_BACKOFF=5s
